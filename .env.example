# DIYALO environment variable template.
# Copy to .env.local for development. NEVER commit real values.
# Stage 0 needs no secrets. Variables for later stages are listed as comments only,
# so that nothing is wired to an unconfirmed provider (see docs/decisions/decision-register.md).

# --- Stage 0 ---
APP_ENV=development            # development | staging | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stage 2 (database / auth): not used yet ---
# DATABASE_URL=
# AUTH_SECRET=

# --- Stage 5 (payments): provider NOT chosen (D-04); do not add provider keys yet ---

# --- Stage 3/4 (private document storage): provider not chosen (D-16) ---
