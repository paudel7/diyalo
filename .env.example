# DIYALO environment variable template.
# Copy to .env.local for development. NEVER commit real values.

# --- Application ---
APP_ENV=development            # development | test | staging | production
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Stage 2) ---
# Runtime connection: the least-privilege role `diyalo_app` (no UPDATE/DELETE/TRUNCATE on audit_logs).
DATABASE_URL=postgres://diyalo_app:CHANGE_ME@localhost:5432/diyalo_dev
# Migrations and reset/seed scripts: the `diyalo_migrator` role (owns the schema). Never used by the running app.
DATABASE_MIGRATION_URL=postgres://diyalo_migrator:CHANGE_ME@localhost:5432/diyalo_dev
# Integration tests only. The database name must contain "test"; it is wiped on every run.
TEST_DATABASE_URL=postgres://diyalo_migrator:CHANGE_ME@localhost:5432/diyalo_test
TEST_APP_DATABASE_URL=postgres://diyalo_app:CHANGE_ME@localhost:5432/diyalo_test

# --- Secrets (generate your own; see docs/stage-2/runbook.md) ---
# 32 random bytes, base64. Encrypts authenticator (TOTP) secrets at rest.   openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# At least 32 characters. Keys the audit-log hash chain.                    openssl rand -base64 48
AUDIT_HMAC_KEY=

# Optional: password for fictional development users created by `pnpm db:seed` (generated if unset).
# SEED_PASSWORD=

# --- Stage 5 (payments): provider NOT chosen (D-04); do not add provider keys yet ---
# --- Stage 3/4 (private document storage, email provider): not chosen (D-16) ---
